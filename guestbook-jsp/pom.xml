<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ro.ucv.inf.ead</groupId>
	<artifactId>guestbook-jsp</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<packaging>war</packaging>

	<name>Guestbook JSP Web Application</name>
	<description>Simpe GuestBook using Servlets and JSP pages</description>

	<organization>
		<name>Department of Computer Science</name>
		<url>http://inf.ucv.ro</url>
	</organization>

	<scm>
		<url>https://github.com/mihaiug/ead/tree/master/guestbook-jsp</url>
	</scm>

	<properties>
		<!-- Compiler settings -->
		<maven.compiler.release>17</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Servlet/JSP API versions (Compatible with Tomcat 10.1+ / Java 17). -->
		<servlet-api.version>6.0.0</servlet-api.version>
		<jsp-api.version>3.1.0</jsp-api.version>
		<jstl.version>3.0.1</jstl.version>

		<!-- Maven Plugin versions -->
		<maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
		<maven-war-plugin.version>3.4.0</maven-war-plugin.version>

		<jetty-maven-plugin.version>12.0.12</jetty-maven-plugin.version>
		<jetty.http.port>8000</jetty.http.port>
	</properties>

	<dependencies>
		<!-- Jakarta Servlet API (scope: provided, as Tomcat 10+ / Jetty 11
		provides it) -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>${servlet-api.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Jakarta Server Pages (JSP) API -->
		<dependency>
			<groupId>jakarta.servlet.jsp</groupId>
			<artifactId>jakarta.servlet.jsp-api</artifactId>
			<version>${jsp-api.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Jakarta Standard Tag Library (JSTL) API  -->
		<dependency>
			<groupId>jakarta.servlet.jsp.jstl</groupId>
			<artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
			<version>${jstl.version}</version>
		</dependency>
		<!-- Jakarta Standard Tag Library (JSTL) Implementation (Glassfish) -->
		<dependency>
			<groupId>org.glassfish.web</groupId>
			<artifactId>jakarta.servlet.jsp.jstl</artifactId>
			<version>${jstl.version}</version>
		</dependency>


	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<!-- JDK Compiler Configuration -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven-compiler-plugin.version}</version>
			</plugin>

			<!-- Plugin for packaging the .war file -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>${maven-war-plugin.version}</version>
				<configuration>
					<!-- Prevents build failure if web.xml is missing (using @WebServlet annotations) -->
					<failOnMissingWebXml>false</failOnMissingWebXml>
				</configuration>
			</plugin>

			<!-- Jetty Plugin to allow running application with mvn jetty:run -->
			<plugin>
				<groupId>org.eclipse.jetty.ee10</groupId>
   				 <artifactId>jetty-ee10-maven-plugin</artifactId>
				<version>${jetty-maven-plugin.version}</version>
				<configuration>
					<webApp>
						<contextPath>/${project.artifactId}</contextPath>
						<!-- Elimină scanarea duplicatelor din JAR-urile de pe classpath -->
            <containerIncludeJarPattern>^$</containerIncludeJarPattern>
					</webApp>
					<!-- Oprește Jetty din a scana clasele duplicate din interiorul JAR-urilor JSTL -->
        <useProvidedScope>true</useProvidedScope>
					<!-- Check for changes and automatically hot redeploy if any
					are detected every 2 seconds -->
					<scan>2</scan>
					<httpConnector>
						<port>${jetty.http.port}</port>
					</httpConnector>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
